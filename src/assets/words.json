            "to":"12"
        },
        "12":{
            "speaker":"バカ生徒",
            "word":"んだよ男かよつまんねー",
            "to":"13"
        },
        "13":{
            "speaker":"桃井",
            "word":"まぁまぁ、そんなこと言わずにね、仲良くしていきましょう",
            "to":"14"
        },
        "14":{
            "speaker":"桃井",
            "word":"では席ですが、空いている所があるのでそこにお願いします",
