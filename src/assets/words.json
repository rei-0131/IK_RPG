        },
        "08":{
            "speaker":"生徒3",
            "word":"(そんなことよりおうどん食べたい)",
            "to":"09"
        },
        "09":{
            "speaker":"桃井",
            "word":"はい、はい、そんなわけでね",
            "to":"10"
        },
        "10":{
            "speaker":"桃井",
            "word":"早速ですが！呼びたいと思います！",
            "to":"11"
        },
        "11":{
            "speaker":"桃井",
            "word":"どうぞ！入ってきてください！",
