{
    "story":{
        "01":{
            "speaker":"桃井",
            "word":"では、僕が呼んだら教室に入ってきてもらっていいですか？",
            "to":"02"
        },
        "02":{
            "speaker":"桃井",
            "word":"えーみなさん、とりあえず席についてもらってもよろしいでしょうか？",
            "to":"03"
        },
        "03":{
            "speaker":"桃井",
            "word":"ありがとうございます。ではですね、本日の連絡なんですが…",
            "to":"04"
        },
        "04":{
            "speaker":"桃井",
            "word":"なんとですね！このクラスに！なんと！",
            "to":"05"
        },
        "05":{
            "speaker":"桃井",
            "word":"転校生が来ます！！！！！",
            "to":"06"
        },
        "06":{
            "speaker":"生徒1",
