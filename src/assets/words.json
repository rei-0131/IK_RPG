{
    "story":{
        "01":{
            "speaker":"桃井",
            "word":"では、僕が呼んだら教室に入ってきてもらっていいですか？",
            "to":"02"
        },
        "02":{
            "speaker":"桃井",
            "word":"えーみなさん、とりあえず席についてもらってもよろしいでしょうか？",
            "to":"03"
        },
        "03":{
            "speaker":"桃井",
            "word":"ありがとうございます。ではですね、本日の連絡なんですが…",
            "to":"04"
        },
        "04":{
            "speaker":"桃井",
            "word":"なんとですね！このクラスに！なんと！",
            "to":"05"
        },
        "05":{
            "speaker":"桃井",
            "word":"転校生が来ます！！！！！",
            "to":"06"
        },
        "06":{
            "speaker":"生徒1",
            "word":"おーまじか",
            "to":"07"
        },
        "07":{
            "speaker":"生徒2",
            "word":"こんな時期に転校か",
            "to":"08"
        },
        "08":{
            "speaker":"生徒3",
            "word":"(そんなことよりおうどん食べたい)",
            "to":"09"
        },
        "09":{
            "speaker":"桃井",
            "word":"はい、はい、そんなわけでね",
            "to":"10"
        },
        "10":{
            "speaker":"桃井",
            "word":"早速ですが！呼びたいと思います！",
            "to":"11"
        },
        "11":{
            "speaker":"桃井",
            "word":"どうぞ！入ってきてください！",
            "questions":["初めまして、よろしくお願いします"],
            "to":"12"
        },
        "12":{
            "speaker":"バカ生徒",
            "word":"んだよ男かよつまんねー",
            "to":"13"
        },
        "13":{
            "speaker":"桃井",
            "word":"まぁまぁ、そんなこと言わずにね、仲良くしていきましょう",
            "to":"14"
        },
        "14":{
            "speaker":"桃井",
            "word":"では席ですが、空いている所があるのでそこにお願いします",
            "questions":["はい、わかりました"],
            "to":"15"
        },
        "15":{
            "speaker":"",
            "word":"数日後",
            "to":"16"
        },
            "16":{
            "speaker":"生徒1",
            "word":"どうだい？この学校にも慣れてきたかい？",
            "questions":["うん。慣れてきた","ボチボチかな"],
            "to":"17"
        },
        "17":{
            "speaker":"生徒2",
            "word":"少しでも慣れているなら良かった",
            "to":"18"
        },
        "18":{
            "speaker":"生徒3",
            "word":"この学校色々やることあるからよこれからもっと大変になるし気をつけな",
            "questions":["わかった","忠告どうも"],
            "to":"19"
        },
        "19":{
            "speaker":"桃井",
            "word":"あの、お話の所すみません。ちょっといいですか？",
            "questions":["全然大丈夫ですよ","何かありましたか？"],
            "to":"20"
        },
        "20":{
            "speaker":"生徒1",
            "word":"ありがとうございます。ここでは話しにくいので廊下に来てもらってもいいですか？",
            "to":"21"
        },
        "21":{
            "speaker":"桃井",
            "word":"すみません、話というのがですね",
            "to":"22"
        },
        "22":{
            "speaker":"桃井",
            "word":"実は、最近いわゆる問題児という生徒に意地悪されてまして",
            "questions":["大変ですね"],
            "to":"23"
        },
        "23":{
            "speaker":"桃井",
            "word":"はい、困ってるんです",
            "to":"24"
        },
        "24":{
            "speaker":"桃井",
            "word":"日に日に意地悪の内容が酷くなっていってですね",
            "to":"25"
        },
        "25":{
            "speaker":"桃井",
            "word":"この間ついに僕の大切な物がいくつか取られてしまったんです！！",
            "questions":["なんと...","そんなことが..."],
            "to":"26"
        },
        "26":{
            "speaker":"桃井",
            "word":"はい、なので転校してきて間もないなか頼むのもあれですが",
            "to":"27"
        } ,
        "27":{
            "speaker":"桃井",
            "word":"僕のその大切なものを問題児生徒から取り返してきてもらっていいですか？",
            "questions":["わかりました","もちろんです"],
            "to":"28"
        } ,
        "28":{
            "speaker":"桃井",
            "word":"ありがとうございます。とても助かります",
            "to":"None",
            "ue":"tmp"
        }
    }
}