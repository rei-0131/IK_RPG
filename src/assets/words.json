        },
        "29":{
            "speaker":"桃井",
            "word":"取り返してきてもらうのをお願いしたわけですが",
            "to":"30"
        } ,
        "30":{
            "speaker":"桃井",
            "word":"この学校...「イチコート魔法学校」は文字通り魔法を教えたり、その他戦闘技術などを教えていたりします",
            "to":"31"
        },
        "31":{
            "speaker":"桃井",
